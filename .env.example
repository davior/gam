# ─── Core ────────────────────────────────────────────────────────────────────

# Port exposed on the host. 18081 is gecko-notes, so GAM takes the next one.
APP_PORT=18082

# REQUIRED. Generate with: openssl rand -hex 32
#
# This MUST be the same value gecko-notes uses. GAM issues no tokens of its own — it
# verifies the ones Notes signs, and a shared HS256 secret is what makes that work.
# It also derives the key that encrypts stored provider API keys, so changing it
# invalidates every session AND every stored key.
JWT_SECRET_KEY=

# Comma-separated exact origins allowed to call the API cross-origin, and — because a
# cookie is an ambient credential — the only foreign origins allowed to make a
# cookie-authenticated write. Same-origin requests are always allowed, so the normal
# deployment needs nothing here. Add a sibling only if it must call GAM's API directly.
#
# DEVELOPMENT NEEDS THIS, production does not. Behind nginx both halves of the app are
# one origin, so the same-origin shortcut applies. In dev they are two: the browser
# sends `Origin: http://localhost:5174` while Vite's `changeOrigin: true` rewrites
# `Host` to `localhost:8001`, the origin check compares host *and port*, and every
# cookie-authenticated POST — every upload — comes back 403 `forbidden_origin` with
# "Cookie authentication requires an allowed Origin". Set it to your Vite origin:
#
#   CORS_ORIGIN=http://localhost:5174
#
# uvicorn reads this once at import, so restart it after changing this file.
CORS_ORIGIN=

# Sign-in: an unauthenticated visitor is sent to Gecko Suite, at SUITE_PUBLIC_URL (set
# with the suite's settings below only when SUITE_BASE_URL is an internal address), else
# SUITE_BASE_URL, the same rule as Notes. GAM has no login form of its own. NOTES_BASE_URL,
# which used to say where, is no longer read; the app logs a reminder while it is set.
#
# The frontend reads this over `GET /api/config` at boot rather than having it compiled
# in, so changing it here and restarting is enough — no rebuild. It used to be a
# `VITE_` variable, which is fixed when the bundle is *built*: setting it in this file
# had no effect at all, and a development instance silently sent people to the
# production Notes login.
#
# Under Docker the same values feed the frontend container's CSP `connect-src`
# (substituted into nginx.conf at container start), so the two always agree.

# The Gecko Notes app itself, not where people sign in: the assistant's notes are filed
# here on Apply, and "Open in Gecko Notes" links here.
NOTES_URL=https://notes.geckopico.com

# Largest upload nginx will accept, in nginx notation. Deliberately generous: long
# video is the point of this application.
UPLOAD_MAX_SIZE=4g

# ─── Media ───────────────────────────────────────────────────────────────────

# How long a signed media URL stays valid, in seconds. Long enough to start playing a
# large video; short enough that a leaked URL stops working. Default 1 hour.
MEDIA_URL_TTL_SECONDS=3600

# ─── Disk space ──────────────────────────────────────────────────────────────
#
# Free space, in GB, on the disk holding media (and, if separate, the database and the
# container's temp space, where uploads and imports land first). Below the first, the
# header shows a warning; below the second, uploads, imports, generations and clip
# extractions are refused until space is freed. Settings → Storage shows the numbers.
DISK_WARN_FREE_GB=20
DISK_RESERVE_GB=5

# ─── Background jobs ─────────────────────────────────────────────────────────

JOB_HEARTBEAT_SECONDS=30
JOB_STALE_MINUTES=40

# ─── Import from URL ─────────────────────────────────────────────────────────
#
# Pasting a YouTube (or Rumble, Odysee, Vimeo, …) link downloads it with yt-dlp. See
# docs/url-import.md, including what to do when imports start failing — YouTube
# changes under yt-dlp every few weeks, and the fix is to bump its pin and rebuild.

# Tallest video to fetch. 1080p is the highest YouTube offers as H.264, which plays in
# every browser; above it you get VP9/AV1, which Safari may refuse.
URL_IMPORT_MAX_HEIGHT=1080

# Most videos one playlist or channel link may queue.
URL_IMPORT_MAX_PLAYLIST_ITEMS=200

# A signed-in YouTube session (a Netscape cookies.txt), for YouTube's "confirm you're not
# a bot" wall — common on VPS/datacenter IPs — and for age-restricted videos.
#
# Under Docker, leave this empty. Put the file at secrets/youtube-cookies.txt and add
# docker-compose.cookies.yml to COMPOSE_FILE (see Reverse proxy, below): that overlay
# mounts secrets/ read-only and sets this for you. Exporting the file from Firefox, and
# why to use a spare account: docs/url-import.md#youtube-cookies
#
# Set it here only to name a different file, or for a bare `uvicorn` dev run, where it
# is a path on your own machine. The file is a login: treat it like a password.
URL_IMPORT_COOKIES_FILE=

# A proxy for imports from sites that refuse this server's IP outright — Cloudflare
# answers many VPS IPs with a JavaScript challenge nothing but a real browser passes
# (Rumble does this). http://, https://, socks4(a):// or socks5(h)://. An SSH tunnel to
# a computer at home makes a free one: docs/url-import.md#when-a-site-blocks-this-servers-ip
URL_IMPORT_PROXY=
# Comma-separated sites the proxy is for (a name covers its subdomains), e.g. rumble.com.
# Empty sends every import through it.
URL_IMPORT_PROXY_HOSTS=

# ─── Administrators ──────────────────────────────────────────────────────────

# Who may edit the AI generation model catalogue, and see the server's disk space and
# clear stray files under Settings → Storage: Gecko Notes user ids or usernames,
# comma-separated, matched exactly (case included). Prefer ids: Notes lets anyone rename
# themselves, so a username somebody gives up can be taken by somebody else. Notes'
# token carries no admin flag, so this is the only way anyone becomes an admin here.
# Empty means nobody — the catalogue still works, as seeded, for everyone.
ADMIN_USERS=

# ─── AI (enrichment and semantic search) ─────────────────────────────────────

# Where the model behind Describe / Summarize / Autotag, and the embeddings behind semantic
# search, come from.
#   local  the providers this app keeps (Settings → AI, and the embedding settings). The
#          default, and what it was before.
#   suite  Gecko Suite: it holds the keys, chooses a model for each job and counts the
#          spend for every app. Set the models up there first, under Routing.
# Either way search works without it (keywords), and the library does not need AI.
# Switching is a restart, not a rebuild, and back is the same.
AI_BACKEND=local

# Where Gecko Suite lives. Only read when AI_BACKEND=suite.
SUITE_BASE_URL=https://suite.geckopico.com
# The suite as people's browsers reach it, where they are sent to sign in. Only needed
# when SUITE_BASE_URL above is an internal address (a compose service name); empty, it
# is SUITE_BASE_URL. As in Notes.
SUITE_PUBLIC_URL=

# REQUIRED when AI_BACKEND=suite (the app refuses to start without it). Enrichment runs as
# background jobs with no user session, so GAM calls the suite as itself, for the owner of
# each asset. An administrator issues this on the suite's Apps screen, which shows it once.
# Never commit it. Issuing a new one revokes the old.
SUITE_APP_SECRET=

# How wide the embedding vectors are. 512 is what this app has always asked OpenAI's
# text-embedding-3 models for, and an existing library's index is 512 wide: vectors of
# another width cannot be compared with it. Do not change it under a populated library
# without re-embedding everything.
SUITE_EMBEDDING_DIMENSIONS=512

# ─── AI generation (fal.ai) ──────────────────────────────────────────────────
#
# Nothing here is a credential: each user adds their own fal.ai key under Settings →
# Generation, and fal bills that account. See docs/m8-ai-generation.md.

# Generations running at once. Each is almost entirely waiting on fal, so this costs the
# container next to nothing; it has its own workers, apart from transcription's.
GENERATION_CONCURRENCY=2

# How long to wait for fal before cancelling the request there and failing the job. A
# request abandoned without that cancel keeps running, and billing, at fal.
GENERATION_TIMEOUT_MINUTES=30

# Seconds between status checks while fal works.
GENERATION_POLL_SECONDS=3

# Largest file one output may be, in MB. Enforced while it downloads, not after.
GENERATION_MAX_DOWNLOAD_MB=1024

# Base images are sent inside the request, so they are resized first: long edge in
# pixels, then a size limit per image in MB that a resized one is refused above.
GENERATION_BASE_MAX_EDGE=2048
GENERATION_MAX_DATA_URI_MB=8

# fal's hosts. Only worth changing if fal moves them.
FAL_QUEUE_BASE_URL=https://queue.fal.run
FAL_API_BASE_URL=https://api.fal.ai

# ─── Development only ────────────────────────────────────────────────────────

# "development" enables DEV_AUTH_USER below. Anything else, and it is ignored.
ENVIRONMENT=production

# Accept unauthenticated requests as this user id, so the app is usable before the
# SSO work in M2 lands. Requires ENVIRONMENT=development as well — one variable alone
# must never be able to switch authentication off.
DEV_AUTH_USER=

# ─── Backup ──────────────────────────────────────────────────────────────────
#
# The backup sidecar is inert until RESTIC_PASSWORD and the SFTP settings are present.
# See ops/backup/README.md for the Synology setup, including the two DSM gotchas that
# are not documented anywhere else.

RESTIC_PASSWORD=
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USER=
# Distinct from gecko-notes', so the two apps' snapshots do not share a path.
BACKUP_SFTP_REMOTE_PATH=/GAM/restic
# Optional plain-file mirror beside the restic repository: SFTP chroot path, e.g.
# /GAM/mirror. Empty = off. See ops/backup/README.md step 13.
BACKUP_MIRROR_PATH=
# Parallel SFTP connections to the NAS. restic's own default of 5 can stall a home
# line badly enough for ssh to drop mid-upload.
BACKUP_SFTP_CONNECTIONS=2
# Optional upload cap in KiB/s for restic and the mirror, e.g. 5000 (about 40 Mbit/s).
# Empty = uncapped. Useful while the first upload of a large library runs.
BACKUP_LIMIT_UPLOAD_KBPS=
BACKUP_CRON_SCHEDULE=0 * * * *
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
TZ=UTC

# ─── Reverse proxy ───────────────────────────────────────────────────────────

# Set this so `docker compose up -d` always includes the prod overlay and cannot
# forget to join the proxy's network.
#
# Once COMPOSE_FILE is set, Compose no longer reads docker-compose.override.yml — every
# overlay you want must be listed here. To give the URL importer YouTube cookies (see
# URL_IMPORT_COOKIES_FILE above), append the cookies overlay:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.cookies.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
