# ─── Core ────────────────────────────────────────────────────────────────────

# Port exposed on the host. 18081 is gecko-notes, so GAM takes the next one.
APP_PORT=18082

# REQUIRED. Generate with: openssl rand -hex 32
#
# This MUST be the same value gecko-notes uses. GAM issues no tokens of its own — it
# verifies the ones Notes signs, and a shared HS256 secret is what makes that work.
# It also derives the key that encrypts stored provider API keys, so changing it
# invalidates every session AND every stored key.
JWT_SECRET_KEY=

# Comma-separated exact origins allowed to call the API cross-origin, and — because a
# cookie is an ambient credential — the only foreign origins allowed to make a
# cookie-authenticated write. Same-origin requests are always allowed, so the normal
# deployment needs nothing here. Add a sibling only if it must call GAM's API directly.
CORS_ORIGIN=

# Where an unauthenticated visitor is sent to sign in. Gecko Notes is the suite's
# identity provider; GAM has no login form of its own.
NOTES_BASE_URL=https://notes.geckopico.com

# Largest upload nginx will accept, in nginx notation. Deliberately generous: long
# video is the point of this application.
UPLOAD_MAX_SIZE=4g

# ─── Media ───────────────────────────────────────────────────────────────────

# How long a signed media URL stays valid, in seconds. Long enough to start playing a
# large video; short enough that a leaked URL stops working. Default 1 hour.
MEDIA_URL_TTL_SECONDS=3600

# ─── Background jobs ─────────────────────────────────────────────────────────

JOB_HEARTBEAT_SECONDS=30
JOB_STALE_MINUTES=40

# ─── Development only ────────────────────────────────────────────────────────

# "development" enables DEV_AUTH_USER below. Anything else, and it is ignored.
ENVIRONMENT=production

# Accept unauthenticated requests as this user id, so the app is usable before the
# SSO work in M2 lands. Requires ENVIRONMENT=development as well — one variable alone
# must never be able to switch authentication off.
DEV_AUTH_USER=

# ─── Backup ──────────────────────────────────────────────────────────────────
#
# The backup sidecar is inert until RESTIC_PASSWORD and the SFTP settings are present.
# See ops/backup/README.md for the Synology setup, including the two DSM gotchas that
# are not documented anywhere else.

RESTIC_PASSWORD=
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USER=
# Distinct from gecko-notes', so the two apps' snapshots do not share a path.
BACKUP_SFTP_REMOTE_PATH=/gam
BACKUP_CRON_SCHEDULE=0 * * * *
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
TZ=UTC

# ─── Reverse proxy ───────────────────────────────────────────────────────────

# Set this so `docker compose up -d` always includes the prod overlay and cannot
# forget to join the proxy's network.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
