# Copy to ops/archive/.env on the NAS and fill in. Setup: ops/archive/README.md.

# The mirror on the NAS, as a DSM path (/volume1/...), not the SFTP chroot path
# (/GeckoNotes/...) that BACKUP_MIRROR_PATH uses on the production host.
GAM_MIRROR_DIR=/volume1/GeckoNotes/gam-mirror

# Whose library the archive shows: your GAM user id, or your Notes username.
READ_ONLY_USER=

# A NEW secret, not production's: openssl rand -hex 32
JWT_SECRET_KEY=

# The port on the NAS. LAN or Tailscale only — never port-forward it.
ARCHIVE_PORT=18083
TZ=UTC
